{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": false,
    "declaration": false,
    "sourceMap": false,
    "incremental": false,
    "isolatedModules": true,
    "outDir": "dist-customer-auth",
    "rootDir": "src",
    "types": ["node"]
  },
  "include": ["src/server/customer-auth/main.ts"],
  "exclude": ["node_modules", "**/*.test.ts", "**/*.test.tsx"]
}
