# Copy this file to `.env.docker.local` (or run `npm run db:env:init`, which
# does this for you and generates strong local passwords) before starting
# the local PostgreSQL container with `npm run db:up`.
#
# This file is committed and contains only unmistakable placeholders — never
# real credentials. `.env.docker.local` is git-ignored and holds the actual
# generated local values; it is read by Docker Compose via `env_file` and is
# never committed. See docker/postgres/init/001-bootstrap.sh and AGENTS.md.
#
# Changing these values after the `postgres-data` volume already exists does
# NOT change the credentials stored inside Postgres — the bootstrap script
# only runs once, against a new empty volume. Use `npm run db:reset` to
# start over with new credentials.

# Local Docker bootstrap superuser. Used only by the PostgreSQL container's
# own initialization scripts — never by BOBA Bear application code, and
# never exposed through the application configuration boundary.
POSTGRES_USER=boba_bear_admin
POSTGRES_PASSWORD=replace-with-generated-local-admin-password
POSTGRES_DB=postgres

# Migration role (owns boba_bear_local and the app/drizzle schemas).
POSTGRES_MIGRATOR_PASSWORD=replace-with-generated-local-migrator-password

# Runtime application role (DML only, no DDL, no ownership).
POSTGRES_APP_PASSWORD=replace-with-generated-local-app-password

# Host port PostgreSQL is published on (container port is always 5432).
POSTGRES_HOST_PORT=5433

# Auth-service secrets are NOT in this file. `npm run docker:env:init`
# generates `.env.runtime.docker.local`, `.env.migration.docker.local`,
# `.env.customer-auth.docker.local` (IMP-009), and
# `.env.workforce-auth.docker.local` (IMP-010) separately — those files
# are git-ignored and never committed.
