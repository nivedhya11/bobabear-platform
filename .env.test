# BOBA Bear application configuration — safe, deterministic test values.
#
# Used by the automated test/CI process kind. No secret is permitted here;
# this file is committed to the repository.

BOBA_BEAR_ENV=test
BOBA_BEAR_PUBLIC_ORIGIN=http://localhost:3000
BOBA_BEAR_LOG_LEVEL=warn
BOBA_BEAR_RELEASE=test
BOBA_BEAR_ALLOW_UNSAFE_ADAPTERS=true
PORT=3000

# Deterministic, credential-free fixture URLs (IMP-004) — schema validation
# only. No real connection is ever attempted with these in the test suite.
BOBA_BEAR_DATABASE_URL=postgresql://boba_bear_app@127.0.0.1:5433/boba_bear_local
BOBA_BEAR_DATABASE_MIGRATION_URL=postgresql://boba_bear_migrator@127.0.0.1:5433/boba_bear_local
BOBA_BEAR_DATABASE_SSL_MODE=disable

# Customer phone + OTP auth service (IMP-009) — deterministic, credential-
# free fixture values, never real secrets. Not read by any current test;
# committed only so the key catalogue matches .env.example.
CUSTOMER_AUTH_SECRET=test-fixture-customer-auth-secret-do-not-reuse-in-real-envs
CUSTOMER_AUTH_BASE_URL=http://localhost:8080
CUSTOMER_AUTH_PII_HASH_SECRET=test-fixture-customer-auth-pii-hash-secret-do-not-reuse
CUSTOMER_OTP_PROVIDER=local
CUSTOMER_OTP_LOCAL_FIXED_CODE=000000
CUSTOMER_AUTH_TRUST_PROXY_HOPS=1
CUSTOMER_AUTH_SERVICE_HOST=0.0.0.0
CUSTOMER_AUTH_SERVICE_PORT=8081

# Workforce email/password + TOTP MFA auth service (IMP-010) — deterministic,
# credential-free fixture values, never real secrets. Committed so the key
# catalogue matches .env.example.
WORKFORCE_AUTH_SECRET=test-fixture-workforce-auth-secret-do-not-reuse-in-real-envs
WORKFORCE_AUTH_BASE_URL=http://localhost:8080
WORKFORCE_AUTH_PII_HASH_SECRET=test-fixture-workforce-auth-pii-hash-secret-do-not-reuse
WORKFORCE_AUTH_TRUST_PROXY_HOPS=1
WORKFORCE_AUTH_SERVICE_HOST=0.0.0.0
WORKFORCE_AUTH_SERVICE_PORT=8082
