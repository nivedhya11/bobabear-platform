# Copy this file to `.env.local` and adjust as needed.
# The site runs fine with no env vars; this is the only optional override.

# Public canonical URL used in <head> metadata, sitemap.xml, robots.txt and
# JSON-LD structured data. Set this to the real production domain (no trailing
# slash) before launch. Defaults to https://bobabear.in when unset.
NEXT_PUBLIC_SITE_URL=https://bobabear.in
