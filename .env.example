# Copy this file to `.env.local` and adjust as needed.
# The site runs without any env vars set; these are all optional overrides.

# Public canonical URL used in <head> metadata, sitemap.xml, robots.txt and
# JSON-LD structured data. Defaults to https://thebobabear.in when unset.
NEXT_PUBLIC_SITE_URL=https://thebobabear.in

# GA4 Measurement ID (format: G-XXXXXXXXXX).
# Find it in Google Analytics → Admin → Data Streams → your stream → Measurement ID.
# When this is empty or unset, analytics scripts are not loaded at all.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-CFR3M3J59V

# ---------------------------------------------------------------------------
# BOBA Bear platform configuration (IMP-003 — see AGENTS.md and
# src/platform/config/). Loaded and validated through the centralized,
# typed configuration boundary — application code must never read these
# via process.env directly.
#
# Never place production secrets or real credentials in this file, or in
# .env.local. It is committed to the repository; .env.local is not.
#
# NEXT_PUBLIC_* variables beyond the two legacy ones above are currently
# prohibited: the browser-public configuration allowlist
# (src/platform/config/public-config.ts) is empty. Adding one requires a
# schema entry, an allowlist entry, tests, documentation, and a security
# review — see AGENTS.md.
#
# Provider/observability variables (auth, OTP, SMS, email, payments,
# delivery, storage, ...) do not exist yet. They will be added just-in-time
# by the platform slices that need them. The local PostgreSQL/Drizzle
# foundation (IMP-004) is the first exception — see below.
# ---------------------------------------------------------------------------

# Required. One of: local, test, ci, staging, production. No aliases.
BOBA_BEAR_ENV=local

# Required. Absolute http(s) origin — scheme + host + optional port only
# (no path, query, fragment, or credentials).
BOBA_BEAR_PUBLIC_ORIGIN=http://localhost:3000

# Optional. One of: debug, info, warn, error. Defaults by environment when
# omitted (local -> debug).
BOBA_BEAR_LOG_LEVEL=debug

# Optional locally; required in staging/production. Any concise, non-empty,
# whitespace-free identifier (git SHA, release tag, ...).
BOBA_BEAR_RELEASE=local-development

# Optional. Exactly "true" or "false" (no "1"/"yes"/"on"). Defaults by
# environment when omitted. Must be "false" in staging/production.
BOBA_BEAR_ALLOW_UNSAFE_ADAPTERS=true

# Web-process only. Integer 1-65535. Defaults to 3000 when omitted.
PORT=3000

# ---------------------------------------------------------------------------
# Local PostgreSQL / Drizzle foundation (IMP-004 — see AGENTS.md and
# src/platform/database/). These are templates, not credentials: run
# `npm run db:env:init` to generate real local connection strings with
# strong generated passwords and synchronize them into .env.local
# automatically. Never put a real generated password in this committed
# file.
# ---------------------------------------------------------------------------

# Web/worker-process only. Runtime application role connection string.
BOBA_BEAR_DATABASE_URL=postgresql://boba_bear_app:replace-with-generated-local-app-password@127.0.0.1:5433/boba_bear_local

# Migration-process only. Migration role connection string.
BOBA_BEAR_DATABASE_MIGRATION_URL=postgresql://boba_bear_migrator:replace-with-generated-local-migrator-password@127.0.0.1:5433/boba_bear_local

# Optional. One of: disable, verify-full. Defaults by environment when
# omitted (local/test/ci -> disable, staging/production -> verify-full).
BOBA_BEAR_DATABASE_SSL_MODE=disable

# ---------------------------------------------------------------------------
# Payment provider (IMP-026A / D-361). Server-only. Never NEXT_PUBLIC_*.
# Selector: disabled | razorpay. Fake is never a production selector.
# When razorpay is selected, all three secrets are required (fail closed).
# ---------------------------------------------------------------------------

# Optional. Defaults to disabled when omitted.
BOBA_BEAR_PAYMENT_PROVIDER=disabled

# Razorpay Key ID. Browser-safe only when later emitted through clientAction.
BOBA_BEAR_RAZORPAY_KEY_ID=replace-with-generated-local-razorpay-key-id

# Razorpay Key Secret. Server only. Never logged. No insecure default.
BOBA_BEAR_RAZORPAY_KEY_SECRET=replace-with-generated-local-razorpay-key-secret

# Razorpay webhook secret. Server only. Never browser-exposed.
BOBA_BEAR_RAZORPAY_WEBHOOK_SECRET=replace-with-generated-local-razorpay-webhook-secret

# ---------------------------------------------------------------------------
# Customer phone + OTP auth service (IMP-009 — see AGENTS.md and
# src/server/customer-auth/, src/server/auth/). A second, narrow config
# boundary (src/server/auth/shared/config.ts), deliberately not folded into
# the BOBA_BEAR_* schema above — read only by the dedicated customer-auth
# Node process (src/server/customer-auth/main.ts), never by the static
# marketing site build. Run `npm run docker:env:init` to generate real local
# secrets into the git-ignored .env.customer-auth.docker.local; never put a
# real generated secret in this committed file.
# ---------------------------------------------------------------------------

# Required. At least 32 characters. Must differ from CUSTOMER_AUTH_PII_HASH_SECRET.
CUSTOMER_AUTH_SECRET=replace-with-generated-local-customer-auth-secret-32-chars-min

# Required. Absolute http(s) origin (no path/query/fragment/credentials) —
# the browser-facing origin the customer realm trusts (matches the Nginx
# proxy's public origin, not the customer-auth service's internal port).
CUSTOMER_AUTH_BASE_URL=http://localhost:8080

# Required. At least 32 characters. Must differ from CUSTOMER_AUTH_SECRET.
# Used only to derive Better Auth's required-but-unused temporary email.
CUSTOMER_AUTH_PII_HASH_SECRET=replace-with-generated-local-pii-hash-secret-32-chars-min

# Optional. One of: local, disabled. Defaults to "disabled". "local" is
# prohibited in staging/production (no approved production provider yet).
CUSTOMER_OTP_PROVIDER=local

# Optional. Exactly six decimal digits. Local/dev/test only — prohibited in
# staging/production. Leave unset for a real per-request random local code.
CUSTOMER_OTP_LOCAL_FIXED_CODE=

# Optional. Integer 0-2. Number of trusted reverse-proxy hops in front of
# this service (the Nginx proxy in docker/nginx/nginx.conf counts as one).
# Defaults to 0.
CUSTOMER_AUTH_TRUST_PROXY_HOPS=1

# Optional. Defaults to 0.0.0.0.
CUSTOMER_AUTH_SERVICE_HOST=0.0.0.0

# Optional. Integer 1-65535. Defaults to 8081.
CUSTOMER_AUTH_SERVICE_PORT=8081

# ---------------------------------------------------------------------------
# Customer-commerce ordering transport (IMP-024 — see
# src/server/customer-commerce/). Thin node:http façade on internal port
# 8083. Session validation reuses CUSTOMER_AUTH_* secrets above.
# ---------------------------------------------------------------------------

# Optional. Defaults to 0.0.0.0.
CUSTOMER_COMMERCE_SERVICE_HOST=0.0.0.0

# Optional. Integer 1-65535. Defaults to 8083.
CUSTOMER_COMMERCE_SERVICE_PORT=8083

# Optional. Integer 0-2. Number of trusted reverse-proxy hops. Defaults to 0.
CUSTOMER_COMMERCE_TRUST_PROXY_HOPS=1

# ---------------------------------------------------------------------------
# Workforce email/password + TOTP MFA auth service (IMP-010 — see
# src/server/workforce-auth/, src/server/auth/). Same narrow config boundary
# pattern as customer-auth above: read only by the dedicated workforce-auth
# Node process (src/server/workforce-auth/main.ts) and operator CLIs under
# scripts/workforce/, never by the static marketing site build. Never put a
# real generated secret in this committed file.
# ---------------------------------------------------------------------------

# Required. At least 32 characters. Must differ from CUSTOMER_AUTH_SECRET
# and from WORKFORCE_AUTH_PII_HASH_SECRET.
WORKFORCE_AUTH_SECRET=replace-with-generated-local-workforce-auth-secret-32-chars-min

# Required. Absolute http(s) origin (no path/query/fragment/credentials) —
# the browser-facing origin the workforce realm trusts.
WORKFORCE_AUTH_BASE_URL=http://localhost:8080

# Required. At least 32 characters. Must differ from WORKFORCE_AUTH_SECRET,
# CUSTOMER_AUTH_SECRET, and CUSTOMER_AUTH_PII_HASH_SECRET. Used only to
# HMAC email/IP rate-limit keys.
WORKFORCE_AUTH_PII_HASH_SECRET=replace-with-generated-local-workforce-pii-hash-secret-32-chars-min

# Optional. Integer 0-2. Number of trusted reverse-proxy hops in front of
# this service. Defaults to 0.
WORKFORCE_AUTH_TRUST_PROXY_HOPS=1

# Optional. Defaults to 0.0.0.0.
WORKFORCE_AUTH_SERVICE_HOST=0.0.0.0

# Optional. Integer 1-65535. Defaults to 8082.
WORKFORCE_AUTH_SERVICE_PORT=8082
