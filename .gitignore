# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/playwright-report-customer-auth
/test-results
/test-results-customer-auth
/test-results-operations-lifecycle
/blob-report

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — .env.local and .env.*.local are always git-ignored (see
# AGENTS.md / docs/platform for the BOBA Bear configuration contract).
# .env.example, .env.test and .env.docker.example are safe, committed
# exceptions. .env.docker.local holds generated local PostgreSQL
# credentials (IMP-004); .env.runtime.docker.local and
# .env.migration.docker.local hold generated least-privilege container
# credentials (IMP-005A); .env.customer-auth.docker.local (IMP-009) and
# .env.workforce-auth.docker.local (IMP-010) hold generated auth-service
# secrets. None of these are ever committed.
.env*
!.env.example
!.env.test
!.env.docker.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# customer-auth service build output (IMP-009 — scripts/customer-auth/build.mjs)
/dist-customer-auth

# workforce-auth service build output (IMP-010 — scripts/workforce-auth/build.mjs)
/dist-workforce-auth
/dist-customer-commerce

# operations service build output (IMP-029 — scripts/operations/build.mjs)
/dist-operations
